---
const highlights = [
  { num: "01", icon: "🎤", title: "AforShow 2023", subtitle: "Conferencista en Twitch", desc: "+300 espectadores en charla sobre desarrollo y buenas prácticas en LATAM.", tag: "(TALK / COMMUNITY)" },
  { num: "02", icon: "🎭", title: "Barrio Teatro", subtitle: "Gestión de Proyecto 2023", desc: "Lideré equipos multidisciplinarios para reducir violencia mediante soluciones culturales.", tag: "(LEADERSHIP)" },
  { num: "03", icon: "🎓", title: "Educación", subtitle: "Ing. de Sistemas", desc: "Universidad Nacional de Cajamarca. Formación rigurosa en computación y algoritmos.", tag: "(ACADEMIC)" },
  { num: "04", icon: "🗣️", title: "Idiomas", subtitle: "Nativo y Avanzado", desc: "Español (Nativo), Inglés (Avanzado profesional para equipos distribuidos globales).", tag: "(LANGUAGES)" },
];

const experienceYears = Math.floor((new Date().getTime() - new Date('2021-09-01').getTime()) / (1000 * 60 * 60 * 24 * 365.25));

const stats = [
  { value: `${experienceYears}+`, label: "Años de experiencia", tag: "(TRAYECTORIA)" },
  { value: "2", label: "Empresas multinacionales", tag: "(GLOBAL IMPACT)" },
  { value: "300+", label: "Audiencia en eventos", tag: "(COMUNIDAD)" },
  { value: "30%", label: "Mejora rendimiento DB", tag: "(PERFORMANCE)" },
];

const certifications = [
  "Scrum Foundation Professional Certificate",
  "Remote Work Professional Certification",
  "Next.js: Framework De React Para Producción",
  "TypeScript Y Práctica Canvas 2021",
  "Vue.js: De Cero A Experto",
  "Docker Avanzado",
  "PostgreSQL & Java Spring"
];
---

<section id="about" class="px-(--gutter)" style="padding-top: var(--section-padding); padding-bottom: var(--section-padding);">
  <div class="max-w-[1400px] mx-auto">
    <!-- Large statement (Wilcock-style) -->
    <div class="mb-24" data-reveal>
      <span class="eyebrow text-(--accent-cyan) block mb-6 font-mono">(HOLA)</span>
      <p class="large-statement">
        Soy Edgar. Desarrollo software que <em>escala</em>, <em>resuelve</em> y
        deja impacto real. Backend en Node.js y Spring Boot,
        frontend en React, desplegado en la <span class="accent">nube</span>.
      </p>
    </div>

    <!-- Section head -->
    <div class="section-head mb-12" data-reveal>
      <div class="flex items-center gap-3">
        <h2 class="eyebrow text-(--text-secondary)">
          Sobre Mí <span class="text-(--text-tertiary)">(01)</span>
        </h2>
      </div>
      <span class="eyebrow text-(--text-tertiary)">+{experienceYears} AÑOS DE EXPERIENCIA</span>
    </div>

    <!-- Content grid: Bio + Stat cards -->
    <div class="grid lg:grid-cols-12 gap-8 items-start mb-14" data-reveal>
      <div class="lg:col-span-7 flex flex-col gap-6 text-(--text-secondary) font-sans text-base sm:text-lg leading-relaxed">
        <p>
          Soy un <span class="text-(--text-primary) font-semibold">Software Engineer</span> con más de <span class="text-(--accent-cyan) font-mono font-medium">{experienceYears} años de experiencia</span> en desarrollo de software, con dominio <span class="text-(--text-primary) font-medium">full-stack</span> en Node.js, Python, Java y Linux — usando React, NestJS, Spring Boot y PostgreSQL.
        </p>
        <p>
          Especializado en la creación de soluciones escalables y eficientes tanto en el <span class="text-(--accent-lime) font-medium">frontend como en el backend</span>, impulsando la calidad del código, metodologías ágiles e integraciones sólidas con servicios en la nube (AWS / Vercel).
        </p>
        <p>
          He <span class="text-(--text-primary) font-semibold">liderado equipos multidisciplinarios</span> fomentando la colaboración técnica y la innovación constante, asegurando el éxito y la escalabilidad de proyectos críticos en diversas industrias en LATAM y Europa.
        </p>
      </div>

      <!-- Stat Cards in Wilcock Aesthetic -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-4">
        {stats.map((stat, idx) => (
          <div class="service-card flex flex-col justify-between p-6">
            <div class="flex items-center justify-between pb-3 border-b border-(--border-color) mb-4">
              <span class="eyebrow text-(--accent-cyan) text-[0.62rem]">{stat.tag}</span>
              <span class="eyebrow text-(--text-tertiary)">0{idx + 1}</span>
            </div>
            <div>
              <div class="font-sans text-4xl sm:text-5xl font-extrabold tracking-tighter text-(--text-primary) mb-2">
                {stat.value}
              </div>
              <div class="font-mono text-xs text-(--text-secondary) uppercase tracking-wider">{stat.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Highlights Cards Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8" data-reveal>
      {highlights.map((h) => (
        <div class="service-card group flex flex-col justify-between p-6">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-(--border-color) mb-4">
              <span class="eyebrow text-(--text-tertiary) group-hover:text-(--text-primary) transition-colors">{h.num}</span>
              <span class="eyebrow text-(--accent-cyan) text-[0.62rem]">{h.tag}</span>
            </div>
            <div class="text-2xl mb-3 opacity-90">{h.icon}</div>
            <h3 class="font-sans font-bold text-xl tracking-tight text-(--text-primary) mb-1 group-hover:text-white transition-colors">
              {h.title}
            </h3>
            <span class="eyebrow text-(--accent-cyan) text-[0.68rem] block mb-3 font-mono">
              {h.subtitle}
            </span>
            <p class="font-sans text-sm text-(--text-secondary) leading-relaxed">
              {h.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications Card in Wilcock Style -->
    <div class="service-card p-6 sm:p-8" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-(--border-color) mb-6">
        <h3 class="font-sans font-bold text-lg sm:text-xl text-(--text-primary) flex items-center gap-2.5">
          <span>📜</span> Certificaciones Profesionales
        </h3>
        <span class="eyebrow text-(--accent-cyan)">07 CERTIFICACIONES VALIDADAS</span>
      </div>
      <div class="flex flex-wrap gap-2">
        {certifications.map((cert) => (
          <span class="font-mono text-xs text-(--text-secondary) border border-(--border-color) bg-white/3 px-3.5 py-1.5 rounded-md hover:border-(--accent-cyan)/50 hover:text-(--text-primary) hover:bg-white/[0.07] transition-all cursor-default uppercase tracking-wider">
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>