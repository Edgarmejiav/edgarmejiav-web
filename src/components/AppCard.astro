---
import IconGitHubSmall from './icons/IconGitHubSmall.astro';
import IconLinkSmall from './icons/IconLinkSmall.astro';

interface Props {
  item: any;
  num?: string;
  tag?: string;
}

const { item, num = "01", tag = "(PROYECTO)" } = Astro.props;
---

<div class="service-card group flex flex-col justify-between p-6 sm:p-7 relative overflow-hidden transition-all duration-300 hover:border-white/20">
  <!-- Subtle ambient glow -->
  <div class="absolute -top-16 -right-16 w-32 h-32 bg-[var(--accent-cyan)]/5 rounded-full blur-2xl pointer-events-none group-hover:bg-[var(--accent-cyan)]/10 transition-colors"></div>

  <div>
    <!-- Top row: Number + Tag + Action Links -->
    <div class="flex items-center justify-between pb-4 border-b border-[var(--border-color)] mb-5">
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-[var(--text-tertiary)] group-hover:text-[var(--text-primary)] transition-colors">
          {num}
        </span>
        <span class="font-mono text-xs text-[var(--accent-cyan)] uppercase tracking-wider">
          {tag}
        </span>
      </div>

      <div class="flex items-center gap-3">
        {item.github && (
          <a
            href={item.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub repository"
            class="text-[var(--text-secondary)] hover:text-white transition-colors"
          >
            <IconGitHubSmall />
          </a>
        )}
        {item.link && (
          <a
            href={item.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Live Demo"
            class="text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] transition-colors"
          >
            <IconLinkSmall />
          </a>
        )}
      </div>
    </div>

    <!-- Title in bold Archivo -->
    <h3 class="font-sans font-bold text-2xl tracking-tight text-[var(--text-primary)] mb-2 group-hover:text-white transition-colors">
      {item.title}
    </h3>

    <!-- Description in Archivo -->
    <p class="font-sans text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
      {item.description}
    </p>
  </div>

  <!-- Tech Stack Chips in Geist Mono -->
  <div class="pt-4 border-t border-[var(--border-color)]/60 mt-auto">
    <div class="flex flex-wrap gap-1.5">
      {item.stack.map((t: string) => (
        <span class="font-mono text-xs text-[var(--text-tertiary)] bg-white/[0.03] border border-[var(--border-color)] px-2.5 py-0.5 rounded-md uppercase tracking-wider group-hover:text-[var(--text-secondary)] transition-colors">
          {t}
        </span>
      ))}
    </div>
  </div>
</div>
