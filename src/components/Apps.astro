---
import data from '../data.json';
import AppCard from './AppCard.astro';

const apps = data.filter((item) => !item?.type?.includes("tutorial"));
const tutorials = data.filter((item) => item?.type?.includes("tutorial"));

const slugify = (str: string) =>
  str
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const gradients = [
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
  "from-white/5 to-white/5 border-white/10",
];
---

<section id="apps" class="py-28 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center gap-4 mb-16">
      <div class="h-px flex-1 bg-gradient-to-r from-transparent to-white/10"></div>
      <h2 class="text-title-2 font-sans text-white"><span class="text-white/40">04.</span> Apps</h2>
      <div class="h-px flex-1 bg-gradient-to-l from-transparent to-white/10"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mb-16">
      {apps.map((item, idx) => {
        const card = <AppCard item={item} gradient={gradients[idx % gradients.length]} />;
        return item.title === "Gemini Float"
          ? <a href={`/apps/${slugify(item.title)}/`} class="block group">{card}</a>
          : card;
      })}
    </div>

    {tutorials.length > 0 && (
      <>
        <div class="flex items-center gap-4 mb-8">
          <div class="h-px flex-1 bg-white/10"></div>
          <h3 class="text-[var(--text-secondary)] text-sm font-medium uppercase tracking-widest">Demos</h3>
          <div class="h-px flex-1 bg-white/10"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          {tutorials.map((item, idx) => (
            <AppCard item={item} gradient={gradients[(idx + apps.length) % gradients.length]} />
          ))}
        </div>
      </>
    )}
  </div>
</section>
