---
const experiences = [
  {
    num: "01",
    title: "Software Engineer",
    company: "Inetum",
    period: "2024 — Actualidad",
    periodDetail: "Jun. 2024 — Presente",
    current: true,
    modality: "Jornada Completa · Remoto LATAM",
    clients: ["Inetum", "Belcorp"],
    category: "(MULTINACIONAL · CORE BACKEND)",
    metrics: [
      { value: "+30%", label: "Rendimiento DB con ETL" },
      { value: "-26%", label: "Duplicación de código" },
    ],
    summary:
      "Desarrollo y optimización de microservicios corporativos de misión crítica para sincronización continua de datos entre plataformas europeas y latinoamericanas.",
    achievements: [
      "Implementé y optimicé microservicios en .NET y Node.js para sincronización de datos en tiempo real.",
