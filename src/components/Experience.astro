---
const featured = {
  title: "Software Engineer",
  company: "Inetum",
  period: "Jun. 2024 — Actualidad",
  type: "Jornada completa · En remoto · LATAM",
  clients: ["Inetum", "Belcorp"],
  metrics: [
    { value: "+30%", label: "Optimización en consultas DB" },
    { value: "-26%", label: "Duplicación de código" },
  ],
  achievements: [
    "Implementé y optimicé microservicios en .NET y Node.js para sincronización de datos en tiempo real.",
    "Diseñé y mantuve procesos ETL con PostgreSQL, mejorando el rendimiento de consultas en más de un 30%.",
    "Integré arquitecturas cloud en AWS S3 y plataformas corporativas internas, garantizando escalabilidad.",
    "Implementé validaciones estrictas de seguridad y auditoría en endpoints críticos.",
    "Reduje un 26% la duplicación de código mediante abstracciones, interfaces y patrones de diseño.",
  ],
  stack: [".NET", "Node.js", "PostgreSQL", "AWS (S3)", "Docker", "Linux", "GitHub Actions", "Microservicios", "ETL", "CI/CD"],
};

const experiences = [
  {
    num: "02",
    title: "Ingeniero de Software Autónomo",
    company: "Freelance",
    type: "Remoto · LATAM",
    period: "2024 — Actualidad",
    current: true,
    achievements: [
      "Ejecución de soluciones tecnológicas personalizadas con Node.js, Python y JavaScript para aumentar la eficiencia operativa en múltiples sectores.",
      "Optimización de flujos de desarrollo garantizando entregas ágiles y flexibles ante requerimientos dinámicos.",
    ],
    stack: ["Node.js", "Python", "JavaScript", "APIs"],
  },
  {
    num: "03",
    title: "Full-stack Developer",
    company: "DATECSOFT S.R.L",
    type: "Remoto · Perú",
    period: "2024 — 2025",
    current: false,
    achievements: [
      "Lideré el modelado de bases de datos en PostgreSQL, facilitando integración continua con Docker y microservicios.",
      "Desarrollé arquitecturas frontend robustas con Angular (TypeScript), optimizando tiempos de carga y UX.",
      "Apliqué optimizaciones técnicas de SEO, incrementando el tráfico orgánico en un 60%.",
    ],
    stack: ["Spring Boot", "Angular", "Java", "TypeScript", "PostgreSQL", "Docker", "AWS"],
  },
  {
    num: "04",
    title: "Desarrollador de Software",
    company: "GRUPO ALVICOM TRADING SRL",
    type: "Cajamarca, Perú",
    period: "2021 — 2024",
    current: false,
    achievements: [
      "Implementé APIs RESTful en Node.js, mejorando el rendimiento del sistema en un 15% mediante optimización de endpoints.",
      "Construí interfaces reactivas y atractivas con React.js, Vue.js, TypeScript y Tailwind CSS.",
      "Alcancé una cobertura de pruebas unitarias superior al 85% con Jest y Testing Library.",
    ],
    stack: ["JavaScript", "React.js", "Vue.js", "TypeScript", "Node.js", "MongoDB", "Jest", "Tailwind CSS"],
  },
];
---

<section id="experience" class="px-[var(--gutter)]" style="padding-top: var(--section-padding); padding-bottom: var(--section-padding);">
  <div class="max-w-[1400px] mx-auto">
    <!-- Section Head Wilcock-style -->
    <div class="section-head mb-12" data-reveal>
      <h2 class="eyebrow text-[var(--text-secondary)]">
        Experiencia Profesional <span class="text-[var(--text-tertiary)]">(04)</span>
      </h2>
      <span class="eyebrow text-[var(--text-tertiary)]">2021 — ACTUALIDAD</span>
    </div>

    <!-- Featured Multinational Experience (Inetum / Belcorp) -->
    <div class="service-card rounded-2xl p-6 sm:p-10 mb-8 border border-[var(--border-color)] bg-[var(--bg-card)] relative overflow-hidden" data-reveal>
      <!-- Ambient corner glow -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-[var(--accent-cyan)]/5 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top metadata -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-[var(--border-color)] mb-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="eyebrow text-[var(--accent-cyan)] font-medium">01 / DESTACADO</span>
          <span class="text-[var(--text-tertiary)]">·</span>
          <span class="eyebrow text-[var(--text-secondary)]">Empresas Multinacionales</span>
          {featured.clients.map((c) => (
            <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-white/5 border border-[var(--border-color)] text-[var(--text-secondary)]">
              🏢 {c}
            </span>
          ))}
        </div>
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1.5 eyebrow text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full text-[0.68rem]">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            ACTUAL
          </span>
          <span class="eyebrow text-[var(--text-tertiary)]">{featured.period}</span>
        </div>
      </div>

      <!-- Main content -->
      <div class="grid lg:grid-cols-12 gap-8 items-start mb-8">
        <div class="lg:col-span-8">
          <h3 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mb-2">
            {featured.title}
          </h3>
          <p class="eyebrow text-[var(--accent-cyan)] text-xs mb-6">
            {featured.company} <span class="text-[var(--text-tertiary)]">/</span> {featured.type}
          </p>

          <ul class="flex flex-col gap-3">
            {featured.achievements.map((item) => (
              <li class="flex items-start gap-3 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
                <span class="text-[var(--accent-cyan)] font-mono shrink-0 mt-0.5">▹</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Metrics Callout Column -->
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3">
          {featured.metrics.map((m) => (
            <div class="p-5 rounded-xl border border-[var(--border-color)] bg-black/30 flex-1">
              <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-primary)] mb-1">
                {m.value}
              </div>
              <div class="eyebrow text-[var(--text-tertiary)] text-[0.65rem]">{m.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tech Stack Tags -->
      <div class="flex flex-wrap gap-2 pt-6 border-t border-[var(--border-color)]">
        {featured.stack.map((t) => (
          <span class="text-xs font-mono text-[var(--text-secondary)] bg-white/4 border border-[var(--border-color)] px-3 py-1 rounded-md hover:border-white/20 transition-colors">
            {t}
          </span>
        ))}
      </div>
    </div>

    <!-- Remaining Experiences Timeline -->
    <div class="flex flex-col gap-4">
      {experiences.map((exp, idx) => (
        <div
          class="service-card rounded-2xl p-6 sm:p-8 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-white/15 transition-all"
          data-reveal
          style={`transition-delay: ${idx * 0.08}s`}
        >
          <div class="flex flex-wrap items-baseline justify-between gap-4 pb-4 border-b border-[var(--border-color)] mb-4">
            <div class="flex items-baseline gap-4">
              <span class="eyebrow text-[var(--text-tertiary)]">{exp.num}</span>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-primary)]">
                  {exp.title}
                </h3>
                <p class="eyebrow text-[var(--accent-cyan)] text-[0.7rem] mt-0.5">
                  {exp.company} <span class="text-[var(--text-tertiary)]">/</span> {exp.type}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              {exp.current && (
                <span class="eyebrow text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full text-[0.65rem]">
                  Actual
                </span>
              )}
              <span class="eyebrow text-[var(--text-tertiary)]">{exp.period}</span>
            </div>
          </div>

          <ul class="flex flex-col gap-2 mb-5">
            {exp.achievements.map((a) => (
              <li class="flex items-start gap-3 text-sm text-[var(--text-secondary)] leading-relaxed">
                <span class="text-[var(--text-tertiary)] font-mono shrink-0 mt-0.5">▹</span>
                <span>{a}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-1.5">
            {exp.stack.map((t) => (
              <span class="text-xs font-mono text-[var(--text-tertiary)] bg-white/2 border border-[var(--border-color)] px-2.5 py-0.5 rounded-md">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>