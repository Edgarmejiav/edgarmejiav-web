---

<section id="experience" class="px-[var(--gutter)]" style="padding-top: var(--section-padding); padding-bottom: var(--section-padding);">
  <div class="max-w-[1400px] mx-auto">
    <!-- Section Head Wilcock-style -->
    <div class="section-head mb-6" data-reveal>
      <div class="flex items-center gap-3">
        <h2 class="eyebrow text-[var(--text-secondary)]">
          Experiencia Profesional <span class="text-[var(--text-tertiary)]">(04)</span>
        </h2>
      </div>
      <div class="flex items-center gap-4 eyebrow text-[var(--text-tertiary)]">
        <span class="text-[var(--accent-cyan)] font-mono">Multinacionales & Startups</span>
        <span class="hidden sm:inline">·</span>
        <span class="hidden sm:inline">2021 — 2026</span>
      </div>
    </div>

    <!-- Editorial Intro Line -->
    <div class="mb-14 pb-8 border-b border-[var(--border-color)]" data-reveal>
      <p class="font-sans text-xl sm:text-2xl text-[var(--text-secondary)] max-w-3xl leading-relaxed">
        Más de <span class="text-[var(--text-primary)] font-medium">4 años</span> liderando y construyendo
        soluciones en empresas multinacionales de Europa y LATAM. De arquitecturas backend complejas a experiencias de usuario de alto impacto.
      </p>
    </div>

    <!-- Experience Rows (Mike Wilcock 3-Column Editorial Layout) -->
    <div class="flex flex-col">
      {experiences.map((exp, idx) => (
        <article
          class="experience-row group"
          data-reveal
          style={`transition-delay: ${idx * 0.08}s`}
        >
          <div class="grid lg:grid-cols-12 gap-8 items-start w-full">
            <!-- Left Column: Number, Title, Company & Meta -->
            <div class="lg:col-span-4 flex flex-col">
              <!-- Eyebrow Number + Tag -->
              <div class="flex items-center gap-3 mb-3">
                <span class="font-mono text-sm font-semibold text-[var(--accent-cyan)]">
                  {exp.num}
                </span>
                <span class="font-mono text-xs text-[var(--text-tertiary)] uppercase tracking-wider">
                  {exp.category}
                </span>
              </div>

              <!-- Huge Role Title in Archivo -->
              <h3 class="experience-title font-sans font-bold tracking-tight text-[var(--text-primary)] group-hover:text-white transition-colors duration-300">
                {exp.title}
              </h3>

              <!-- Company & Modality -->
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="font-sans font-semibold text-lg text-[var(--accent-cyan)]">
                  {exp.company}
                </span>
                {exp.clients.length > 0 && (
                  <div class="flex items-center gap-1.5">
                    <span class="text-[var(--text-tertiary)]">/</span>
                    {exp.clients.map((c) => (
                      <span class="font-mono text-xs px-2 py-0.5 rounded-full bg-white/[0.04] border border-[var(--border-color)] text-[var(--text-secondary)] uppercase tracking-wider">
                        🏢 {c}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <span class="font-mono text-xs text-[var(--text-tertiary)] mt-1.5 uppercase tracking-wider">
                {exp.modality}
              </span>
            </div>

            <!-- Center Column: Summary, Standout Metrics & Impact Bullets -->
            <div class="lg:col-span-5 flex flex-col">
              <!-- Summary paragraph -->
              <p class="font-sans text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed mb-5">
                {exp.summary}
              </p>

              <!-- Metrics highlight cards if available -->
              {exp.metrics.length > 0 && (
                <div class="grid grid-cols-2 gap-3 mb-6">
                  {exp.metrics.map((m) => (
                    <div class="p-4 rounded-xl border border-[var(--border-color)] bg-black/40 flex flex-col justify-between">
                      <div class="font-sans font-black text-2xl sm:text-3xl tracking-tighter text-[var(--text-primary)] mb-1">
                        {m.value}
                      </div>
                      <div class="font-mono text-[0.65rem] uppercase tracking-wider text-[var(--accent-cyan)]">
                        {m.label}
                      </div>
                    </div>
                  ))}
                </div>
              )}

              <!-- Achievements list -->
              <ul class="flex flex-col gap-2.5">
                {exp.achievements.map((item) => (
                  <li class="flex items-start gap-3 text-xs sm:text-sm text-[var(--text-secondary)] font-sans leading-relaxed">
                    <span class="text-[var(--accent-cyan)] font-mono shrink-0 mt-0.5 text-xs">▹</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Right Column: Period Badge & Tech Stack Chips -->
            <div class="lg:col-span-3 flex flex-col lg:items-end">
              <!-- Period badge -->
              <div class="flex items-center gap-2 mb-6">
                {exp.current && (
                  <span class="flex items-center gap-1.5 font-mono text-[0.68rem] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    ACTUAL
                  </span>
                )}
                <span class="font-mono text-xs text-[var(--text-tertiary)] bg-white/[0.02] border border-[var(--border-color)] px-3 py-1 rounded-full">
                  {exp.periodDetail}
                </span>
              </div>

              <!-- Tech chips in Wilcock rounded-full style -->
              <div class="w-full lg:text-right">
                <span class="eyebrow text-[var(--text-tertiary)] text-[0.62rem] block mb-2.5">STACK TECNOLÓGICO</span>
                <div class="flex flex-wrap lg:justify-end gap-1.5">
                  {exp.stack.map((t) => (
                    <span class="experience-chip">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-row {
    display: flex;
    padding: clamp(36px, 5vw, 56px) 0;
    border-bottom: 1px solid var(--border-color);
    position: relative;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .experience-row:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: linear-gradient(90deg, rgba(6, 182, 212, 0.03) 0%, transparent 80%);
    padding-left: 12px;
  }

  .experience-title {
    font-size: clamp(28px, 3.5vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .experience-chip {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 6px 12px;
    transition: all 0.2s ease;
  }

  .experience-row:hover .experience-chip {
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--text-primary);
  }

  .experience-chip:hover {
    border-color: var(--accent-cyan) !important;
    color: white !important;
    background: rgba(6, 182, 212, 0.1) !important;
  }
</style>