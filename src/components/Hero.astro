---
const experienceYears = Math.floor((new Date().getTime() - new Date('2021-09-01').getTime()) / (1000 * 60 * 60 * 24 * 365.25));
const firstName = "EDGAR";
const lastName = "MEJÍA V.";
---

<section id="hero" class="relative flex flex-col justify-between min-h-screen px-(--gutter) pt-24 pb-12 overflow-hidden">
  <!-- Top eyebrow row -->
  <div class="flex items-center justify-between eyebrow" data-reveal>
    <span>(Portfolio / ©{new Date().getFullYear()})</span>
    <span class="hidden sm:inline">Software Engineer</span>
    <span>Perú, LATAM</span>
  </div>

  <!-- Massive name -->
  <div class="flex-1 flex flex-col justify-center py-8">
    <h1 class="kinetic-name" aria-label="Edgar Mejía V.">
      <span class="line-first" aria-hidden="true">
        {firstName.split('').map((letter, i) => (
          <span class="kinetic__letter" style={`animation-delay: ${0.05 + i * 0.06}s`}>{letter}</span>
        ))}
      </span>
      <span class="line-second" aria-hidden="true">
        {lastName.split('').map((letter, i) => (
          <span class="kinetic__letter" style={`animation-delay: ${0.35 + i * 0.06}s`}>{letter === ' ' ? '\u00A0' : letter}</span>
        ))}
      </span>
    </h1>
  </div>

  <!-- Bottom row -->
  <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6">
    <div class="max-w-md" data-reveal>
      <p class="text-lg sm:text-xl text-(--text-secondary) leading-relaxed">
        Desarrollo software <em class="not-italic text-(--text-primary)">escalable</em> y
        <em class="not-italic text-(--text-primary)">eficiente</em> para empresas
        multinacionales. Microservicios, APIs y apps con impacto real.
      </p>

      <!-- Typewriter role -->
      <p class="mt-3 text-base text-(--text-tertiary) font-mono">
        <span class="text-(--accent-cyan)">&lt;</span>
        <span id="role-text"></span>
        <span class="animate-blink text-(--accent-cyan)">|</span>
        <span class="text-(--accent-cyan)"> /&gt;</span>
      </p>
    </div>

    <div class="flex flex-col items-end gap-4" data-reveal>
      <span class="eyebrow text-(--text-tertiary)">↓ scroll, suave</span>
      <a
        href="#about"
        class="eyebrow inline-flex items-center gap-2 px-5 py-3 rounded-full border border-(--border-color) text-(--text-primary) hover:bg-white/5 transition-all duration-300"
      >
        Ver más →
      </a>
    </div>
  </div>
</section>

<script>
  const roles = ["Software Engineer", "Backend Developer", "Frontend Developer", "Microservices Architect", "Tech Lead"];
  let roleIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const roleText = document.getElementById('role-text');
  const speed = 90;
  const deleteSpeed = 50;
  const pauseTime = 1500;

  function typeEffect() {
    if (!roleText) return;
    const current = roles[roleIndex];

    if (!isDeleting) {
      roleText.textContent = current.substring(0, charIndex + 1);
      charIndex++;
      if (charIndex === current.length) {
        setTimeout(() => { isDeleting = true; typeEffect(); }, pauseTime);
        return;
      }
    } else {
      roleText.textContent = current.substring(0, charIndex - 1);
      charIndex--;
      if (charIndex === 0) {
        isDeleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
      }
    }
    setTimeout(typeEffect, isDeleting ? deleteSpeed : speed);
  }

  typeEffect();

  // Reveal animation observer
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('[data-reveal]').forEach(el => {
    revealObserver.observe(el);
  });
</script>