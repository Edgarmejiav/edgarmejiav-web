---
const items = ["Backend", "Frontend", "Microservicios", "Node.js", "React", "Spring Boot", "AWS", "Docker", "APIs", "PostgreSQL"];
---

<div class="marquee">
  <div class="marquee__track">
    <div class="marquee__copy">
      {items.map((item) => (
        <>
          <span>{item}</span>
          <span class="marquee__diamond" aria-hidden="true"></span>
        </>
      ))}
    </div>
    <div class="marquee__copy" aria-hidden="true">
      {items.map((item) => (
        <>
          <span>{item}</span>
          <span class="marquee__diamond" aria-hidden="true"></span>
        </>
      ))}
    </div>
  </div>
</div>
