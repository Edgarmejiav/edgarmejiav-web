---
const navLinks = [
  { href: "#about", label: "Sobre Mí" },
  { href: "#stack", label: "Stack" },
  { href: "#experience", label: "Experiencia" },
  { href: "#apps", label: "Apps" },
];

const now = new Date();
const timeStr = now.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', hour12: false });
---

<header class="fixed top-0 z-50 w-full transition-all duration-500" id="navbar">
  <div class="max-w-[1400px] mx-auto flex items-center justify-between px-(--gutter) h-16">
    <!-- Logo -->
    <a href="#hero" class="flex items-center gap-0 group" id="nav-logo">
      <span class="font-extrabold text-sm uppercase tracking-tight text-(--text-primary)">Edgar</span>
      <span class="relative inline-flex items-center mx-0.5">
        <span class="absolute inset-0 bg-(--accent-cyan) rounded-[3px] scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
        <span class="relative text-sm italic font-medium text-(--text-primary) px-1">m</span>
      </span>
      <span class="font-normal text-sm text-(--text-primary)">ejía</span>
    </a>

    <!-- Status (location + time) -->
    <div class="hidden md:flex items-center gap-2 eyebrow text-(--text-secondary)">
      <span>Perú, LATAM</span>
      <span class="text-(--text-tertiary)">/</span>
      <span id="live-time">{timeStr}</span>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="eyebrow text-(--text-secondary) hover:text-(--text-primary) px-4 py-2 rounded-lg hover:bg-white/5 transition-all duration-200"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#contacto"
        class="eyebrow ml-2 px-4 py-2.5 rounded-full bg-(--accent-cyan) text-black! font-bold tracking-wider hover:opacity-85 transition-opacity duration-200"
      >
        Contáctame
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      class="md:hidden text-(--text-secondary) hover:text-(--text-primary) p-2 rounded-lg hover:bg-white/5 transition-colors"
      id="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="flex flex-col gap-1.5 w-5" id="menu-bars">
        <span class="w-full h-[1.5px] bg-current transition-all duration-300 origin-center" id="bar1"></span>
        <span class="w-full h-[1.5px] bg-current transition-all duration-300" id="bar2"></span>
      </span>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="md:hidden bg-(--bg-primary)/95 backdrop-blur-xl border-t border-(--border-color) px-(--gutter) overflow-hidden transition-all duration-500"
    style="max-height: 0; opacity: 0;"
    aria-label="Mobile navigation"
  >
    <div class="py-6 flex flex-col gap-1">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="flex items-center justify-between py-3 px-3 rounded-lg hover:bg-white/5 transition-all group"
        >
          <span class="text-(--text-primary) text-lg font-medium">{link.label}</span>
          <span class="eyebrow text-(--text-tertiary)">0{i + 1}</span>
        </a>
      ))}
      <div class="mt-4 pt-4 border-t border-(--border-color)">
        <a
          href="#contacto"
          class="block text-center eyebrow px-4 py-3 rounded-full bg-(--accent-cyan) text-black! font-bold tracking-wider"
        >
          Contáctame
        </a>
      </div>
      <div class="mt-4 flex items-center justify-between eyebrow text-(--text-tertiary)">
        <span>legamejiav@gmail.com</span>
        <span>Perú, LATAM</span>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  let isOpen = false;

  btn?.addEventListener('click', () => {
    isOpen = !isOpen;
    btn.setAttribute('aria-expanded', String(isOpen));

    if (isOpen) {
      menu!.style.maxHeight = menu!.scrollHeight + 'px';
      menu!.style.opacity = '1';
      bar1!.style.transform = 'rotate(45deg) translateY(3px)';
      bar2!.style.transform = 'rotate(-45deg) translateY(-3px)';
    } else {
      menu!.style.maxHeight = '0';
      menu!.style.opacity = '0';
      bar1!.style.transform = '';
      bar2!.style.transform = '';
    }
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', () => {
      isOpen = false;
      btn!.setAttribute('aria-expanded', 'false');
      menu!.style.maxHeight = '0';
      menu!.style.opacity = '0';
      bar1!.style.transform = '';
      bar2!.style.transform = '';
    });
  });

  // Navbar background on scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-(--bg-primary)/90', 'backdrop-blur-xl', 'border-b', 'border-(--border-color)');
    } else {
      navbar?.classList.remove('bg-(--bg-primary)/90', 'backdrop-blur-xl', 'border-b', 'border-(--border-color)');
    }
  }, { passive: true });

  // Live time update
  const timeEl = document.getElementById('live-time');
  if (timeEl) {
    setInterval(() => {
      const now = new Date();
      timeEl.textContent = now.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', hour12: false });
    }, 60000);
  }
</script>