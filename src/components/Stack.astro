---
const techGroups = [
  { category: "Backend", icon: "⚙️", items: ["Java", "Python", "Node.js", ".NET", "Spring Boot", "FastAPI", "NestJS", "OAuth"] },
  { category: "Bases de Datos", icon: "🗄️", items: ["PostgreSQL", "MongoDB", "SQL"] },
  { category: "Frontend", icon: "🎨", items: ["JavaScript", "TypeScript", "React.js", "Vue.js", "Angular", "Redux.js", "Tailwind CSS", "Bootstrap", "Material-UI", "Styled-components", "HTML", "CSS", "Webpack", "Storybook", "HTTPS"] },
  { category: "CI/CD & Cloud", icon: "☁️", items: ["GitHub Actions", "Vercel", "AWS Amplify", "Azure Static Web Apps", "Docker", "Linux", "AWS S3", "AWS CloudFront"] },
  { category: "Pruebas y Calidad", icon: "🧪", items: ["Jest", "Storybook", "Selenium", "Mocha", "Chai", "Testing Library", "Postman", "ESLint", "Prettier"] },
  { category: "Gestión y Metodologías", icon: "📊", items: ["Scrum", "Kanban", "Agile", "Jira", "Notion", "Git"] },
];
---

<section id="stack" class="px-[var(--gutter)]" style="padding-top: var(--section-padding); padding-bottom: var(--section-padding);">
  <div class="max-w-[1400px] mx-auto">
    <!-- Section head (Wilcock-style) -->
    <div class="section-head mb-8" data-reveal>
      <h2 class="eyebrow text-[var(--text-secondary)]">Stack Tecnológico <span class="text-[var(--text-tertiary)]">(02)</span></h2>
      <span class="eyebrow text-[var(--text-tertiary)]">{techGroups.reduce((acc, g) => acc + g.items.length, 0)} tecnologías</span>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
      {techGroups.map((group, idx) => (
        <div class="service-card" data-reveal style={`transition-delay: ${idx * 0.08}s`}>
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xl opacity-80">{group.icon}</span>
            <h3 class="text-[var(--text-primary)] font-medium text-base">{group.category}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {group.items.map((tech) => (
              <span class="text-xs font-medium text-[var(--text-secondary)] bg-white/3 border border-[var(--border-color)] rounded-lg px-2.5 py-1 hover:bg-white/8 hover:text-[var(--text-primary)] hover:border-white/15 transition-all duration-200 cursor-default">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>